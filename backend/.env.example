# Copy to .env and fill in. The app is LIVE-ONLY (no mock data): it boots
# without these but data endpoints are unavailable until Supabase (and the
# relevant data sources) are configured. The model is trained offline by the
# weekly job; the app serves whatever is already in Supabase.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=
# Direct Postgres by parts (recommended — robust to special chars in password).
# Use the Session Pooler values from Supabase: Connect -> Session pooler.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Dubai Pulse (DLD) — legacy, no longer the active source ---
DUBAI_PULSE_API_KEY=
DUBAI_PULSE_BASE_URL=https://api.data.dubai.gov.ae

# --- DLD via data.dubai (DDA OpenAPI) — LIVE source for training data ---
# Endpoint: https://apis.data.dubai/open/dld/dld_transactions-open-api
# Credentials are issued by the DDA integration team after API access approval.
# The DLD client is live-only; without these it cannot fetch and the ingest
# step is skipped (the app still boots and serves the trained model).
DLD_BASE_URL=https://apis.data.dubai
DLD_ENTITY=dld
DLD_DATASET=dld_transactions-open-api
DLD_CLIENT_ID=
DLD_CLIENT_SECRET=
DLD_SECURITY_IDENTIFIER=
# Approved quota for this application — do not raise above what DDA granted.
DLD_MAX_REQUESTS_PER_MINUTE=20
DLD_MAX_REQUESTS_PER_DAY=500
DLD_PAGE_SIZE=1000
DLD_REQUEST_TIMEOUT_S=30
# Records per ingest run. Set 1 for the first verification pull, then raise it
# (or 0 = no cap for a full incremental pull).
DLD_FETCH_LIMIT=1

# --- API security (secured inbound endpoints) ---
# JWT signing secret. REQUIRED for the admin/auth endpoints to work at all.
# Generate a strong one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# If left blank, the secured endpoints fail closed (refuse all requests).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
# Admin login for triggering ingestion. The password is stored ONLY as a bcrypt
# hash — never put a plaintext password here. Generate the hash with:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Comma-separated CORS allowlist for the frontend in production, e.g.
#   https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*

# --- World Bank ---
WORLDBANK_BASE_URL=https://api.worldbank.org/v2

# --- EIA ---
EIA_API_KEY=
EIA_BASE_URL=https://api.eia.gov/v2

# --- Open-Meteo (no key needed) ---
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1

# --- SerpAPI (optional) ---
SERP_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
MODEL_ARTEFACTS_DIR=./artefacts
